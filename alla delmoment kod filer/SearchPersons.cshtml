@{
    ViewBag.Title = "SearchPersons";
}
<h2>Sokresultat personer</h2>
<table border="1">
    <tr>
        @foreach (var dataColumn in ViewBag.SearchResults.Columns)
        {
            <th>@dataColumn.ColumnName</th>
        }
    </tr>
    @foreach (var personRow in ViewBag.SearchResults.Rows)
    {
        <tr>
        @for (int i = 0; i < ViewBag.SearchResults.Columns.Count; ++i)
        {
            <td>@personRow[i]</td>
        }
        </tr>
    }
</table>
<br />
@Html.ActionLink("Link back to persons", "Index", "Person")
